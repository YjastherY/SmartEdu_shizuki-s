generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

enum LessonType {
  VIDEO
  TEXT
  TEST
}

enum QuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  MATCHING
  MANUAL
}

enum SubmissionStatus {
  PENDING
  GRADED
}

enum AttemptStatus {
  GRADED
  PENDING_REVIEW
}

model User {
  id            String         @id @default(cuid())
  name          String
  email         String         @unique
  passwordHash  String
  avatarUrl     String?
  role          Role           @default(STUDENT)
  darkMode      Boolean        @default(false)
  groupId       String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  group         Group?         @relation("GroupStudents", fields: [groupId], references: [id], onDelete: SetNull)
  teachingGroups Group[]       @relation("GroupTeacher")
  createdTests  Test[]         @relation("TestCreator")
  progress      Progress[]
  comments      Comment[]
  notifications Notification[]
  certificates  Certificate[]
  testAttempts  TestAttempt[]
  manualSubmissions ManualSubmission[]
  deadlineExtensions DeadlineExtension[]
  chatMessages  ChatMessage[]
  courses       CourseUser[]
}

model Group {
  id        String   @id @default(cuid())
  title     String
  teacherId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  teacher   User?    @relation("GroupTeacher", fields: [teacherId], references: [id], onDelete: SetNull)
  students  User[]   @relation("GroupStudents")
  courses   GroupCourse[]
  chatMessages ChatMessage[]
}

model GroupCourse {
  id       String @id @default(cuid())
  groupId  String
  courseId String
  group    Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([groupId, courseId])
}

model Course {
  id          String        @id @default(cuid())
  title       String
  description String
  category    String
  level       String
  imageUrl    String?
  duration    String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  modules     Module[]
  progress    Progress[]
  certificates Certificate[]
  groups      GroupCourse[]
  users       CourseUser[]
}

model CourseUser {
  id       String @id @default(cuid())
  userId   String
  courseId String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

model Module {
  id        String   @id @default(cuid())
  title     String
  order     Int
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons   Lesson[]
}

model Lesson {
  id          String       @id @default(cuid())
  title       String
  type        LessonType   @default(VIDEO)
  order       Int
  duration    String
  content     String?
  videoUrl    String?
  imageUrl    String?
  isPublished Boolean      @default(true)
  visibleFrom DateTime?
  moduleId    String
  module      Module       @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  test        Test?
  comments    Comment[]
  completions LessonCompletion[]
}

model Test {
  id               String        @id @default(cuid())
  title            String
  description      String?
  attemptLimit     Int           @default(2)
  timeLimitMinutes Int           @default(15)
  deadline         DateTime?
  lessonId         String        @unique
  creatorId        String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @default(now()) @updatedAt
  lesson           Lesson        @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  creator          User?         @relation("TestCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  questions        Question[]
  attempts         TestAttempt[]
  deadlineExtensions DeadlineExtension[]
}

model Question {
  id        String   @id @default(cuid())
  text      String
  type      QuestionType @default(SINGLE_CHOICE)
  maxScore  Int      @default(10)
  order     Int      @default(1)
  testId    String
  test      Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  answers   Answer[]
  submissions ManualSubmission[]
}

model Answer {
  id         String   @id @default(cuid())
  text       String
  isCorrect  Boolean  @default(false)
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model Progress {
  id              String   @id @default(cuid())
  userId          String
  courseId        String
  completedLessons Int     @default(0)
  totalLessons     Int     @default(0)
  averageScore     Int     @default(0)
  percent          Int     @default(0)
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course           Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

model LessonCompletion {
  id        String   @id @default(cuid())
  userId    String
  lessonId  String
  createdAt DateTime @default(now())
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

model TestAttempt {
  id          String   @id @default(cuid())
  userId      String
  testId      String
  score       Int
  autoScore   Int      @default(0)
  manualScore Int?
  earnedPoints Int     @default(0)
  totalPoints Int      @default(0)
  answerSnapshot Json?
  reviewSnapshot Json?
  feedback    String?
  status      AttemptStatus @default(GRADED)
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  test        Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  manualSubmissions ManualSubmission[]
}

model ManualSubmission {
  id         String   @id @default(cuid())
  userId     String
  attemptId  String
  questionId String
  answer     String
  score      Int?
  maxScore   Int
  feedback   String?
  status     SubmissionStatus @default(PENDING)
  createdAt  DateTime @default(now())
  gradedAt   DateTime?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  attempt    TestAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model DeadlineExtension {
  id        String   @id @default(cuid())
  userId    String
  testId    String
  deadline  DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  test      Test     @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@unique([userId, testId])
}

model Certificate {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  code      String   @unique
  issuedAt  DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model Comment {
  id        String   @id @default(cuid())
  text      String
  userId    String
  lessonId  String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(cuid())
  title     String
  message   String
  type      String?
  targetPath String?
  metadata  Json?
  read      Boolean  @default(false)
  userId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ChatMessage {
  id        String   @id @default(cuid())
  text      String
  userId    String
  groupId   String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  group     Group?   @relation(fields: [groupId], references: [id], onDelete: Cascade)
}
